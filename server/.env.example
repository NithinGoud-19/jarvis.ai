# Copy this file to ".env" and change values if needed.
# .env is NOT committed to Git (it can hold secrets later, like OAuth keys).

PORT=4000
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct
# Where the React app runs (allowed by CORS)
CLIENT_ORIGIN=http://localhost:5173

# Gmail (free Google OAuth "Desktop app" client). See README "Gmail setup".
# The SECRET must stay only in this file (never in code, Git, or chat).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
